# Generate each secret: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SETUP_TOKEN=replace-with-a-different-random-setup-token
# Local development uses Vite at this origin.
PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_DOMAIN=replace-with-domain
PORT=3000
VITE_PORT=5173
DATABASE_PATH=data/luna.sqlite
MEDIA_PATH=uploads
# Optional. Leave empty to show an editable placeholder in the login banner.
GITHUB_REPOSITORY_URL=
# Comma-separated exact proxy IPs/CIDRs. Leave empty without a proxy.
# Match the reverse proxy's real network address; do not use unconditional trust.
TRUST_PROXY=replace-with-proxy-service-ip
REVERSE_PROXY_NETWORK=repace-with-procy
